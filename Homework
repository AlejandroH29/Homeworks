Arrays Functions:

1) at() -> Devuelve el elemento en el índice especificado
let frutas = ['manzana', 'banana', 'pera'];
console.log(frutas.at(1)); // banana

2) concat() -> Une dos o más arrays
let a = ['rojo', 'verde'];
let b = ['azul', 'amarillo'];
console.log(a.concat(b)); // ['rojo', 'verde', 'azul', 'amarillo']

3) copyWithin() -> Copia una parte del array dentro del mismo
let numeros = [1, 2, 3, 4, 5];
console.log(numeros.copyWithin(0, 3)); // [4, 5, 3, 4, 5]

4) entries() -> Devuelve un iterador con pares [índice, valor]
let animales = ['gato', 'perro'];
for (let [index, value] of animales.entries()) {
    console.log(index, value);
}

5) every() -> Comprueba si todos los elementos cumplen la condición
let nums = [2, 4, 6];
console.log(nums.every(n => n % 2 === 0)); // true

6) fill() -> Rellena el array con un valor
let arr = [1, 2, 3, 4];
console.log(arr.fill(0, 1, 3)); // [1, 0, 0, 4]

7) filter() -> Filtra elementos según una condición
let edades = [15, 22, 18, 30];
console.log(edades.filter(e => e >= 18)); // [22, 18, 30]

8) find() -> Devuelve el primer elemento que cumple la condición
let nombres = ['Ana', 'Pedro', 'Luis'];
console.log(nombres.find(n => n.startsWith('P'))); // Pedro

9) findIndex() -> Devuelve el índice del primer elemento que cumple la condición
console.log(nombres.findIndex(n => n.startsWith('P'))); // 1

10) findLast() -> Devuelve el último elemento que cumple la condición
console.log(nombres.findLast(n => n.length > 3)); // Pedro

11) findLastIndex() -> Índice del último elemento que cumple la condición
console.log(nombres.findLastIndex(n => n.length > 3)); // 1

12) flat() -> Aplana arrays anidados
let arr2 = [1, [2, [3, 4]]];
console.log(arr2.flat(2)); // [1, 2, 3, 4]

13) flatMap() -> Mapea y aplana el resultado
let frases = ["Hola mundo", "Adiós mundo"];
console.log(frases.flatMap(f => f.split(' '))); // ['Hola', 'mundo', 'Adiós', 'mundo']

14) forEach() -> Ejecuta una función por cada elemento
nombres.forEach(n => console.log(n));

15) includes() -> Comprueba si un valor existe en el array
console.log(nombres.includes('Ana')); // true

16) indexOf() -> Devuelve el índice de la primera ocurrencia
console.log(nombres.indexOf('Luis')); // 2

17) join() -> Une los elementos en un string
console.log(nombres.join(', ')); // "Ana, Pedro, Luis"

18) keys() -> Devuelve los índices como iterador
for (let key of nombres.keys()) {
    console.log(key);
}

19) lastIndexOf() -> Índice de la última ocurrencia
let letras = ['a', 'b', 'a'];
console.log(letras.lastIndexOf('a')); // 2

20) map() -> Crea un nuevo array aplicando una función
let dobles = [1, 2, 3].map(n => n * 2);
console.log(dobles); // [2, 4, 6]

21) pop() -> Elimina el último elemento
let colores = ['rojo', 'verde', 'azul'];
console.log(colores.pop()); // azul

22) push() -> Agrega elementos al final
colores.push('amarillo');
console.log(colores); // ['rojo', 'verde', 'amarillo']

23) reduce() -> Reduce a un solo valor
let suma = [1, 2, 3].reduce((acc, val) => acc + val, 0);
console.log(suma); // 6

24) reduceRight() -> Igual que reduce, pero de derecha a izquierda
let concat = ['a', 'b', 'c'].reduceRight((acc, val) => acc + val, '');
console.log(concat); // "cba"

25) reverse() -> Invierte el array
console.log([1, 2, 3].reverse()); // [3, 2, 1]

26) shift() -> Elimina el primer elemento
let dias = ['lunes', 'martes'];
console.log(dias.shift()); // lunes

27) slice() -> Extrae una parte sin modificar el original
let partes = ['a', 'b', 'c', 'd'].slice(1, 3);
console.log(partes); // ['b', 'c']

28) some() -> Comprueba si al menos un elemento cumple la condición
console.log([1, 3, 5].some(n => n % 2 === 0)); // false

29) sort() -> Ordena los elementos
console.log(['pera', 'manzana', 'banana'].sort());

30) splice() -> Añade o elimina elementos
let meses = ['Ene', 'Feb', 'Mar'];
meses.splice(1, 1, 'Abr');
console.log(meses); // ['Ene', 'Abr', 'Mar']

31) toLocaleString() -> Convierte a string con formato local
console.log([1000, 2000].toLocaleString()); // "1,000,2,000" (en-US)

32) toString() -> Convierte a string
console.log([1, 2, 3].toString()); // "1,2,3"

33) unshift() -> Agrega elementos al inicio
let num = [2, 3];
num.unshift(1);
console.log(num); // [1, 2, 3]

34) values() -> Devuelve un iterador con los valores
for (let val of ['x', 'y'].values()) {
    console.log(val);
}
